{{- if eq .chezmoi.os "windows" -}}
# Delegate to the central, idempotent package handler.
$ErrorActionPreference = 'Stop'
$src = chezmoi source-path 2>$null
if (-not $src) { $src = Join-Path $HOME '.local\share\chezmoi' }
$handler = Join-Path $src 'handlers\package_handler.ps1'
if (Test-Path $handler) {
    . $handler
    Install-Package -PackageName 'tree-sitter-cli' -PackageType 'standalone-binary' | Out-Null
} else {
    Write-Warning "tree-sitter install: package handler not found at $handler; skipping"
}
{{- end -}}
