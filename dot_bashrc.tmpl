# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# Platform-specific config
if [ -d /data/data/com.termux/files/usr/bin ]; then
    . ~/.bashrc.termux
elif [ -n "$WSL_DISTRO_NAME" ]; then
    . ~/.bashrc.wsl
elif command -v starship >/dev/null 2>&1; then
    case "${PROMPT_COMMAND-}" in
        *starship_precmd*) ;;
        *) eval "$(starship init bash)" ;;
    esac
fi

HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s checkwinsize

{{ if eq .chezmoi.os "linux" -}}
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"
{{ end -}}

if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

force_color_prompt=yes
if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
esac

{{ if eq .chezmoi.os "linux" -}}
if command -v dircolors &>/dev/null; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi
{{ else -}}
if command -v gdircolors &>/dev/null; then
    test -r ~/.dircolors && eval "$(gdircolors -b ~/.dircolors)" || eval "$(gdircolors -b)"
    alias ls='gls --color=auto'
fi
alias grep='grep --color=auto'
{{ end -}}

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias lt='ls -ltr'
alias ..='cd ..'
alias ...='cd ../..'
alias ~='cd ~'
alias h='history'

alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# Git shortcuts (chezmoi: dot_git_shortcuts.tmpl -> ~/.git_shortcuts).
if [ -f ~/.git_shortcuts ]; then
    . ~/.git_shortcuts
fi

# Idempotent PATH prepend: safe to `source ~/.bashrc` repeatedly.
__chezmoi_path_prepend_once() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}
__chezmoi_path_prepend_once "$HOME/.local/go/bin"
__chezmoi_path_prepend_once "$HOME/go/bin"
__chezmoi_path_prepend_once "$HOME/.local/bin"
__chezmoi_path_prepend_once "$HOME/.opencode/bin"
export PATH
unset -f __chezmoi_path_prepend_once
# Clean pre-existing duplicates left by the old config (keep first occurrence).
__chezmoi_deduped=""
__chezmoi_old_ifs="$IFS"; IFS=:
for __chezmoi_p in $PATH; do
    [ -n "$__chezmoi_p" ] || continue
    case ":$__chezmoi_deduped:" in
        *":$__chezmoi_p:"*) ;;
        *) __chezmoi_deduped="${__chezmoi_deduped:+$__chezmoi_deduped:}$__chezmoi_p" ;;
    esac
done
IFS="$__chezmoi_old_ifs"
PATH="$__chezmoi_deduped"
export PATH
unset __chezmoi_deduped __chezmoi_p __chezmoi_old_ifs

{{ if eq .chezmoi.os "linux" -}}
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi
{{ else -}}
if ! shopt -oq posix; then
    if [ -f /usr/local/share/bash-completion/bash_completion ]; then
        . /usr/local/share/bash-completion/bash_completion
    elif [ -f /opt/homebrew/etc/bash_completion ]; then
        . /opt/homebrew/etc/bash_completion
    fi
fi
{{ end -}}

export NVM_DIR="$HOME/.nvm"
# Load nvm once: re-sourcing re-runs `nvm_auto use` (slow) and rewrites PATH.
if ! command -v nvm >/dev/null 2>&1; then
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
fi
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
