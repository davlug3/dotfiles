{{- if eq .chezmoi.os "windows" -}}
# Installs vim-plug and runs PlugInstall for classic Vim on Windows.
# nvim plugins are handled by lazy.nvim (see ~/.config/nvim/init.lua).
$ErrorActionPreference = 'Stop'

$plugPath = Join-Path $HOME '.vim\autoload\plug.vim'

if (-not (Test-Path $plugPath)) {
    Write-Host "installing vim-plug..."
    $dir = Split-Path $plugPath -Parent
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
    Invoke-WebRequest -UseBasicParsing `
        -Uri 'https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim' `
        -OutFile $plugPath
}

# Re-run PlugInstall only when the vimrc (plugin list) changed.
$marker = Join-Path $HOME '.cache\vim-plug-installed'
$vimrc = Join-Path $HOME '.vimrc'
$currentHash = if (Test-Path $vimrc) { (Get-FileHash $vimrc -Algorithm SHA256).Hash } else { 'missing' }
if ((Test-Path $marker) -and ((Get-Content $marker -Raw).Trim() -eq $currentHash)) {
    Write-Host 'plugins already installed; skipping PlugInstall'
    exit 0
}

$vim = Get-Command vim -ErrorAction SilentlyContinue
if (-not $vim) { $vim = Get-Command gvim -ErrorAction SilentlyContinue }
if ($vim) {
    Write-Host "running PlugInstall..."
    try {
        & $vim.Source '-E' '-s' '-c' 'PlugInstall --sync' '-c' 'qa'
    } catch {
        Write-Warning "PlugInstall reported an error: $($_.Exception.Message)"
    }
    $cacheDir = Split-Path $marker -Parent
    if (-not (Test-Path $cacheDir)) { New-Item -ItemType Directory -Force -Path $cacheDir | Out-Null }
    Set-Content -Path $marker -Value $currentHash
} else {
    Write-Host "vim not found; skipping PlugInstall (install vim and re-run chezmoi apply)"
}
Write-Host "plugin installation done"
{{- end -}}
