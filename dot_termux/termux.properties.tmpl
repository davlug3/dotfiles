{{- if .termux }}
# --- Termux extra-keys for Vim mobile IDE ---
# CTRL/ALT are "sticky" in Termux: tap CTRL, then tap another key,
# and it sends Ctrl+<key> without needing a real chord.
# Long-press any key to get its popup alternate.
#
# After editing, run: termux-reload-settings
# (or long-press the Termux notification icon and reload)

# Row 1: modifiers + escape + nav + symbols
extra-keys = [['ESC','CTRL','ALT','TAB','-','/',':','.','HOME','END'],['UP','DOWN','LEFT','RIGHT','PIPE','BACKSLASH','BACKSPACE','DEL']]
{{- end }}