# Mobile-friendly tmux settings for Termux Android
# Automatically loaded on Termux Android via filesystem detection

# Enable touch support
set -g mouse on

# Increase scrollback history for easier reading
set -g history-limit 10000

# Simplify status bar for small screens
set -g @dracula-show-powerline false
set -g @dracula-show-flags false
set -g @dracula-plugins ""

# Optimize for performance on mobile
set -g repeat-time 600
set -sg escape-time 10

# Make copy mode more touch-friendly
bind -T copy-mode-vi v send -X begin-selection

# Use larger pane borders for easier touch targeting
set -g pane-border-lines heavy

# Battery optimization - reduce refresh
set -g status-interval 5

# Mobile keyboard considerations - shorter prefix mode timeout
set -g display-panes-time 500

# Termux clipboard integration
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "termux-clipboard-set"
bind C-S send-keys -X copy-pipe-and-cancel "termux-clipboard-set"

# Quick terminal resize for mobile orientation changes
bind R refresh-client -S

# Swipe-like gesture emulation for navigation
# Using less-common key combinations that won't conflict with standard tmux/vim usage

# Horizontal swipe-like navigation (left/right between panes)
bind -n M-, if -F "#{pane_in_mode}" "send-keys -X exit" "select-pane -L" \; display "◀ Swipe: Left"
bind -n M-. if -F "#{pane_in_mode}" "send-keys -X exit" "select-pane -R" \; display "Swipe: Right ▶"

# Vertical swipe-like navigation (up/down between windows)
bind -n M-/ if -F "#{pane_in_mode}" "send-keys -X exit" "select-window -t :-" \; display "▲ Swipe: Up"
bind -n M-p if -F "#{pane_in_mode}" "send-keys -X exit" "select-window -t :+" \; display "▼ Swipe: Down"

# Quick window switching with visual feedback (alternative set)
bind -n M-h previous-window \; display "◀ Swipe: Prev Window"
bind -n M-l next-window \; display "Swipe: Next Window ▶"

# Zoom toggle for pinch-like behavior
bind -n M-z resize-pane -Z \; display "Pinch: #{window_zoom}"

# Quick save-all (double-tap gesture)
bind -n M-S run "tmux capture-pane -pS -100 > ~/tmux_session_$(date +%s).txt && tmux display 'Session saved'"

# Terminal paste from clipboard
bind -n M-v run "tmux set-buffer \"$(termux-clipboard-get 2>/dev/null)\" && tmux paste-buffer" 2>&1
