# Mobile-friendly tmux settings for Termux Android
# Automatically loaded on Termux Android via filesystem detection

# ─── Core Touch Settings ────────────────────────────────────────────────
# CRITICAL: Disable mouse in tmux to allow touch gestures to pass directly
# to child applications (Neovim) for cursor-only movement
set -g mouse off

# Enable focus events and direct passthrough for better touch handling
set -g focus-events on
set -g allow-passthrough on

# Proper terminal configuration for touch support
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"
set -ga terminal-overrides ',*:Smulx=\E[4::%p1%dm'

# Visual enhancements for touch targeting
set -g pane-border-lines single
set -g pane-border-status top
set -g pane-border-format " #{pane_index} "

# Performance optimizations
set -g repeat-time 300
set -sg escape-time 10
set -g history-limit 50000
set -g status-interval 2
set -g display-panes-time 300

# ─── Terminal/Tmux Integration for Touch Gestures ──────────────────────
# Ensure arrow keys and touch events pass through to child apps
unbind-key -T root Up
unbind-key -T root Down
unbind-key -T root Left
unbind-key -T root Right

# ─── Touch-Friendly Navigation ─────────────────────────────────────────
# Alt+directional keys for tmux navigation (doesn't interfere with app gestures)
bind -n M-h if -F "#{pane_in_mode}" "send-keys -X exit" "select-pane -L" \; display "◀ Swipe: Left"
bind -n M-l if -F "#{pane_in_mode}" "send-keys -X exit" "select-pane -R" \; display "Swipe: Right ▶"
bind -n M-j if -F "#{pane_in_mode}" "send-keys -X exit" "select-window -t :+" \; display "▼ Swipe: Down"
bind -n M-k if -F "#{pane_in_mode}" "send-keys -X exit" "select-window -t :-" \; display "▲ Swipe: Up"

# Diagonal gestures for split management
bind -n M-H split-window -h \; display "Split Horizontal"
bind -n M-J split-window -v \; display "Split Vertical"
bind -n M-K resize-pane -U 5 \; display "Resize Up"
bind -n M-L resize-pane -R 5 \; display "Resize Right"

# Special gestures
bind -n M-z resize-pane -Z \; display "Pinch: #{window_zoom}"
bind -n M-R refresh-client -S \; display "Orientation: Refreshed"
bind -n M-W run "tmux capture-pane -pS -100 > ~/tmux_session_$(date +%s).txt && tmux display 'Session saved'"

# Clipboard integration
bind -n M-P run "tmux set-buffer \"$(termux-clipboard-get 2>/dev/null)\"; tmux paste-buffer" 2>&1
bind -n M-Y run "tmux save-buffer - | termux-clipboard-set"

# ─── Clean Status Bar for Mobile ───────────────────────────────────────
set -g status-style "fg=white,bg=black"
set -g status-left "#[fg=green]#[bg=default] [#S] "
set -g status-right "#[fg=cyan] %Y-%m-%d %H:%M "

# Simplified window status for touch targeting
set -g window-status-current-style "fg=black,bg=cyan,bold"
set -g window-status-style "fg=white,bg=default"
set -g window-status-format " [#{window_index}] "
set -g window-status-current-format " [#W] "
