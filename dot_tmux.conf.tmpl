unbind r
bind r source-file ~/.tmux.conf
set -g default-terminal "tmux-256color"

# Load mobile-friendly config on Termux Android
# Uses filesystem check as it's more reliable than environment vars
if-shell "test -d /data/data/com.termux" \
    "source-file ~/.tmux-mobile.conf" ""
setw -g mode-keys vi
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R

set -g @tpm_plugins 'tpm'
if "test ! -d ~/.tmux/plugins/tpm" \
   "run 'git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm && ~/.tmux/plugins/tpm/bin/install_plugins'"

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'dracula/tmux'


set -g @dracula-show-powerline true
set -g @dracula-show-flags true
set -g @dracula-day-month true
set -g @dracula-fixed-location "Manila"
set -g @dracula-plugins "weather"
set -g @dracula-show-left-icon session
set -g @dracula-left-icon-padding 1
set -g @dracula-battery-label "Battery"
set -g @dracula-border-contrast true
set -g @dracula-cpu-usage-label "CPU"
set -g status-position bottom

# Extended-keyboard (CSI-u) support.
# tmux auto-detects extkeys for mintty/iTerm2/foot/WezTerm/ghostty/XTerm, but
# NOT alacritty, so declare it here. Scoped to alacritty so a conhost or VS Code
# attach can't accidentally inherit it and re-trigger the hex-garbage bug.
set -g -a terminal-features '*alacritty*:extkeys'
set -g extended-keys on
set -g extended-keys-format csi-u

run '~/.tmux/plugins/tpm/tpm'

# vim-tmux-navigator binds root C-h -> select-pane -L, which hijacks the
# 0x08 byte that most terminals send for Ctrl+Backspace (== Ctrl+H).
# Unbind it so Ctrl+Backspace passes through to the shell instead of
# jumping panes. Ctrl+j/k/l navigation and prefix h/j/k/l still work.
unbind-key -n C-h



# panes
set -g pane-border-style 'fg=red'
set -g pane-active-border-style 'fg=yellow'

# messages
set -g message-style 'fg=yellow bg=red bold'



