{{- if eq .chezmoi.os "windows" -}}
# Install ripgrep for use with Telescope live_grep.
# If rg is already on PATH Neovim/Telescope will use it automatically;
# otherwise a native grep fallback is configured in lua/plugins/telescope.lua.
# Works without admin: winget user scope first, then portable zip fallback.
$ErrorActionPreference = 'Stop'

function Update-SessionPath {
    $machine = [System.Environment]::GetEnvironmentVariable('Path', 'Machine')
    $user = [System.Environment]::GetEnvironmentVariable('Path', 'User')
    if ($machine -and $user) { $env:Path = "$machine;$user" }
    elseif ($machine) { $env:Path = $machine }
    elseif ($user) { $env:Path = "$env:Path;$user" }
}

if (Get-Command rg -ErrorAction SilentlyContinue) {
    $version = (& rg --version | Select-Object -First 1)
    Write-Host "ripgrep already installed: $version"
    exit 0
}

# Strategy 1: winget (user scope avoids UAC; --source winget avoids msstore 12002)
if (Get-Command winget -ErrorAction SilentlyContinue) {
    try {
        Write-Host "trying winget..."
        winget install --id BurntSushi.ripgrep.MSVC --exact --source winget --scope user --accept-source-agreements --accept-package-agreements
        Update-SessionPath
        if (Get-Command rg -ErrorAction SilentlyContinue) {
            Write-Host "ripgrep installed via winget"
            exit 0
        }
        Write-Warning "winget BurntSushi.ripgrep_MSU not found, trying Microsoft.Grep..."
        winget install --id Microsoft.Grep --exact --source winget --scope user --accept-source-agreements --accept-package-agreements
        Update-SessionPath
        if (Get-Command rg -ErrorAction SilentlyContinue) {
            Write-Host "ripgrep installed via winget"
            exit 0
        }
        Write-Warning "winget did not leave rg on PATH (exit=$LASTEXITCODE)"
    } catch {
        Write-Warning "winget failed: $($_.Exception.Message)"
    }
}

# Strategy 2: portable zip from GitHub releases (no admin).
Write-Host "trying GitHub releases..."
$binDir = Join-Path $HOME '.local\bin'
if (-not (Test-Path $binDir)) { New-Item -ItemType Directory -Path $binDir -Force | Out-Null }
$tempDir = $env:TEMP
if (-not $tempDir) { $tempDir = $env:TMP }
if (-not $tempDir) { $tempDir = [System.IO.Path]::GetTempPath() }
$arch = 'x86_64'
if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { $arch = 'aarch64' }
$release = Invoke-RestMethod -UseBasicParsing -Uri 'https://api.github.com/repos/BurntSushi/ripgrep/releases/latest'
$tag = $release.tag_name
$asset = "ripgrep-$($tag)-$arch-pc-windows-msvc.zip"
$url = "https://github.com/BurntSushi/ripgrep/releases/download/$tag/$asset"
Write-Host "Downloading ripgrep $tag ($asset)..."
$zip = Join-Path $tempDir 'ripgrep.zip'
Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $zip
$extractDir = Join-Path $tempDir 'ripgrep-extract'
if (Test-Path $extractDir) { Remove-Item $extractDir -Recurse -Force -ErrorAction SilentlyContinue }
try {
    Expand-Archive -Path $zip -DestinationPath $extractDir -Force
    $rgExe = Get-ChildItem -Path $extractDir -Filter 'rg.exe' -Recurse | Select-Object -First 1
    if (-not $rgExe) { throw "rg.exe not found in $asset" }
    Copy-Item -Path $rgExe.FullName -Destination (Join-Path $binDir 'rg.exe') -Force
} finally {
    Remove-Item $zip -Force -ErrorAction SilentlyContinue
    Remove-Item $extractDir -Recurse -Force -ErrorAction SilentlyContinue
}
if ($env:Path -notlike "*$binDir*") { $env:Path = "$env:Path;$binDir" }
Update-SessionPath
if ($env:Path -notlike "*$binDir*") { $env:Path = "$env:Path;$binDir" }

if (Get-Command rg -ErrorAction SilentlyContinue) {
    Write-Host "ripgrep installed via GitHub releases"
    exit 0
}
Write-Warning "ripgrep installation failed; Telescope will use grep fallback"
exit 0
{{- end -}}
