[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}

[core]
    editor = vim
    excludesfile = ~/.gitignore

[init]
    defaultBranch = main

[alias]
    # Core shortcuts
    st   = status -s
    co   = checkout
    br   = branch
    ci   = commit
    cm   = commit -m
    di   = diff
    df   = diff
    dc   = diff --cached
    aa   = add -A

    # Advanced workflow and logging
    lg   = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    cane = commit --amend --no-edit
    amend = commit --amend --no-edit
    last = log -1 HEAD
    undo = reset HEAD~1 --mixed
    undo-soft = reset --soft HEAD~1
    unstage = reset HEAD --

    # Utilities
    aliases = config --get-regexp alias
    prune-branches = !git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -d
    discard = restore .
    pu = push
    pl = pull --rebase

{{ if eq .chezmoi.os "darwin" -}}
[credential]
    helper = osxkeychain
{{ else -}}
[credential]
    helper = cache --timeout=3600
{{ end -}}

[include]
    # Keeps your public GitHub repo clean by loading secrets locally
    path = ~/.gitconfig.local
