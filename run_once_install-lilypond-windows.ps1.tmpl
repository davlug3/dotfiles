{{- $installLilypond := false -}}
{{- if hasKey . "install_lilypond" -}}{{- $installLilypond = .install_lilypond -}}{{- end -}}
{{- if and (eq .chezmoi.os "windows") $installLilypond -}}
# Thin wrapper: auto-install on first apply when prompted Yes.
# Manual re-run any time with: & "$HOME/installers/install-lilypond.ps1"
$ErrorActionPreference = 'Stop'

$installer = "$HOME/installers/install-lilypond.ps1"
if (Test-Path $installer) {
    & $installer
} else {
    $src = (chezmoi source-path 2>$null)
    if (-not $src) { $src = "$HOME/.local/share/chezmoi" }
    & "$src/installers/install-lilypond.ps1"
}
{{- end -}}
