{{- $installNvim := false -}}
{{- if hasKey . "install_nvim" -}}{{- $installNvim = .install_nvim -}}{{- end -}}
{{- if and (eq .chezmoi.os "windows") $installNvim -}}
# Thin wrapper: auto-install on first apply when prompted Yes.
# Manual re-run any time with: & "$HOME/installers/install-nvim.ps1"
$ErrorActionPreference = 'Stop'

$installer = "$HOME/installers/install-nvim.ps1"
if (Test-Path $installer) {
    & $installer
} else {
    $src = (chezmoi source-path 2>$null)
    if (-not $src) { $src = "$HOME/.local/share/chezmoi" }
    & "$src/installers/install-nvim.ps1"
}
{{- end -}}
