"$schema" = 'https://starship.rs/config-schema.json'

# ─────────────────────────────────────────────────────────────────────────────
# Starship Config — modern Unicode/ASCII (no Nerd Font required)
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Palette (Catppuccin Mocha)
# ─────────────────────────────────────────────────────────────────────────────
[palettes.catppuccin]
rosewater = "#f5e0dc"
flamingo  = "#f2cdcd"
pink      = "#f5c2e7"
mauve     = "#cba6f7"
red       = "#f38ba8"
maroon    = "#eba0ac"
peach     = "#fab387"
yellow    = "#f9e2af"
green     = "#a6e3a1"
teal      = "#94e2d5"
sky       = "#89dceb"
sapphire  = "#74c7ec"
blue      = "#89b4fa"
lavender  = "#b4befe"
text      = "#cdd6f4"
subtext1  = "#bac2de"
subtext0  = "#a6adc8"
overlay2  = "#9399b2"
overlay1  = "#7f849c"
overlay0  = "#6c7086"
surface2  = "#585b70"
surface1  = "#45475a"
surface0  = "#313244"
base      = "#1e1e2e"
mantle    = "#181825"
crust     = "#11111b"

# ─────────────────────────────────────────────────────────────────────────────
# Character (prompt symbol)
# ─────────────────────────────────────────────────────────────────────────────
[character]
success_symbol = "[❯](bold green)"
error_symbol   = "[❯](bold red)"
vicmd_symbol   = "[❮](bold yellow)"

# ─────────────────────────────────────────────────────────────────────────────
# Username & Hostname
# ─────────────────────────────────────────────────────────────────────────────
[username]
show_always = true
style_user = "bold blue"
style_root = "bold red"
format = "[$user](fg:blue) "

[hostname]
ssh_only = false
format = "@[$hostname](fg:magenta) "
style = "bold"

# ─────────────────────────────────────────────────────────────────────────────
# Directory
# ─────────────────────────────────────────────────────────────────────────────
[directory]
style = "bold cyan"
truncation_length = 3
truncation_symbol = ".../"
truncate_to_repo = false
fish_style_pwd_dir_length = 1
format = "[$path]($style) "
home_symbol = "~"

# ─────────────────────────────────────────────────────────────────────────────
# Git Branch
# ─────────────────────────────────────────────────────────────────────────────
[git_branch]
format = "on [$branch](fg:mauve) "
style = "bold"

# ─────────────────────────────────────────────────────────────────────────────
# Git Status
# ─────────────────────────────────────────────────────────────────────────────
[git_status]
conflicted = "! "
ahead = "^${count}"
behind = "v${count}"
diverged = "<>"
untracked = "?"
stashed = "S"
modified = "M"
deleted = "D"
renamed = "R"
typechanged = ""
style = "red"
disabled = false

# ─────────────────────────────────────────────────────────────────────────────
# Languages / Toolchains
# ─────────────────────────────────────────────────────────────────────────────

[python]
symbol = "py "
format = "via [$symbol$version](fg:yellow) "
style = "yellow"
python_binary = ["python3", "python"]
pyenv_version_name = true

[nodejs]
symbol = "node "
format = "via [$symbol$version](fg:green) "
style = "green"

[rust]
symbol = "rs "
format = "via [$symbol$version](fg:red) "
style = "red"

[golang]
symbol = "go "
format = "via [$symbol$version](fg:cyan) "
style = "cyan"

[docker_context]
symbol = "docker "
format = "via [$symbol$context](fg:blue) "
style = "blue"
only_with_files = true

[kubernetes]
symbol = "k8s "
format = "via [$symbol$context(/$namespace)](fg:blue) "
style = "blue"
disabled = false

# ─────────────────────────────────────────────────────────────────────────────
# Command Duration
# ─────────────────────────────────────────────────────────────────────────────
[cmd_duration]
min_time = 2000
format = "took [$duration](fg:yellow) "
style = "yellow"
show_notifications = true
notification_timeout = 30000

# ─────────────────────────────────────────────────────────────────────────────
# Time (right side)
# ─────────────────────────────────────────────────────────────────────────────
[time]
disabled = false
format = "🕐 [$time](fg:overlay0) "
time_format = "%H:%M:%S"
style = "overlay0"

# ─────────────────────────────────────────────────────────────────────────────
# Battery (right side)
# ─────────────────────────────────────────────────────────────────────────────
[battery]
full_symbol = "100%"
charging_symbol = "+"
discharging_symbol = "-"
display = [
  { threshold = 10, style = "bold red" },
  { threshold = 30, style = "bold yellow" },
  { style = "bold green" }
]
format = "[$symbol$percentage]($style) "

# ─────────────────────────────────────────────────────────────────────────────
# Line break
# ─────────────────────────────────────────────────────────────────────────────
[line_break]
disabled = false

# ─────────────────────────────────────────────────────────────────────────────
# Main prompt format
# ─────────────────────────────────────────────────────────────────────────────
format = """
$username$hostname\
$directory\
$git_branch$git_status\
$python$nodejs$rust$golang$docker_context$kubernetes\
$cmd_duration\
$line_break$character"""

right_format = "$time$battery"

# ─────────────────────────────────────────────────────────────────────────────
# Disable noisy modules
# ─────────────────────────────────────────────────────────────────────────────
[aws]
disabled = true

[azure]
disabled = true

[gcloud]
disabled = true

[conda]
disabled = true

[package]
disabled = true

[cmake]
disabled = true

[meson]
disabled = true

[nix_shell]
disabled = true

[zig]
disabled = true

[vlang]
disabled = true
