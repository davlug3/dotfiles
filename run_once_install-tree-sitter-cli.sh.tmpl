{{- if ne .chezmoi.os "windows" -}}
{{- if env "TERMUX_VERSION" -}}
{{- /* tree-sitter is installed via `pkg install tree-sitter` in the Termux deps script */ -}}
{{- else -}}
#!/usr/bin/env bash
# Delegate to the central, idempotent package handler.
set -Eeuo pipefail
SRC="$(chezmoi source-path 2>/dev/null || printf '%s' "${HOME}/.local/share/chezmoi")"
if [[ -f "${SRC}/handlers/package_handler.sh" ]]; then
  # shellcheck source=handlers/package_handler.sh
  source "${SRC}/handlers/package_handler.sh"
  install_package tree-sitter-cli standalone-binary latest ""
else
  echo "tree-sitter install: package handler not found at ${SRC}; skipping" >&2
fi
{{- end -}}
{{- end -}}
